##urban_ndm##state    real   TRB_URB4D_colapsed    i{umap0}j    misc       1         Z     rh{12}      "TRB_URB4D_colapsed"       "STREET DIRECTIONS COLAPSED ROOF LAYER TEMPERATURE"  


# All collapsed urban variables
state    real   TLEV_URB3D_colapsed      ij   misc       1         Z     rh{12}      "TLEV_URB3D_colapsed" "COLAPSED INDOOR TEMPERATURE"             "K"
state    real   QLEV_URB3D_colapsed      ij   misc       1         Z     rh{12}      "QLEV_URB3D_colapsed" "COLAPSED SPECIFIC HUMIDITY"              "dimensionless"

