state    integer urban_map_zd_wgt     i{umap4}j   misc       1         Z     rh{12}      "urban_map_zd_wgt"        "urban_map_zd WEIGHTS"         "1."
state    integer urban_map_zdf_wgt    i{umap5}j   misc       1         Z     rh{12}      "urban_map_zdf_wgt"       "urban_map_zdf WEIGHTS"        "1."
state    integer urban_map_bd_wgt     i{umap6}j   misc       1         Z     rh{12}      "urban_map_bd_wgt"        "urban_map_bd WEIGHTS"         "1."
state    integer urban_map_wd_wgt     i{umap7}j   misc       1         Z     rh{12}      "urban_map_wd_wgt"        "urban_map_wd WEIGHTS"         "1."
